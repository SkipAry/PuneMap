      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Phone</span><input class=\"ds-input\" placeholder=\"98220 14455\"></label>",
      "css": ".ds-field{display:block;font-family:'Google Sans',system-ui,sans-serif}.ds-field-label{display:block;margin-bottom:5px;font-size:13px;font-weight:600;color:#101828}.ds-input{width:100%;min-height:40px;padding:8px 12px;border:1px solid rgba(16,24,40,.16);border-radius:10px;background:#fff;color:#101828;font-family:inherit;font-size:15px}.ds-input::placeholder{color:#98a2b3}.ds-input:hover{border-color:rgba(16,24,40,.3)}.ds-input:focus-visible{outline:2px solid #1862dc;outline-offset:2px}"
    },
