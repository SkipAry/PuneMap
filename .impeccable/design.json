  "components": [
    {
      "name": "Sign Panel",
      "kind": "custom",
      "refersTo": "panel",
      "description": "The one repeated object: translucent white floating over the map, never opaque.",
      "html": "<div class=\"ds-panel\"><strong>13</strong> matches</div>",
      "css": ".ds-panel{background:rgba(255,255,255,.94);backdrop-filter:blur(14px) saturate(1.4);border:1px solid rgba(16,24,40,.08);border-radius:16px;box-shadow:0 8px 28px rgba(16,24,40,.12),0 1px 3px rgba(16,24,40,.08);padding:12px 16px;font-family:'Google Sans',system-ui,sans-serif;font-size:15px;color:#101828}.ds-panel strong{font-variant-numeric:tabular-nums;font-weight:600}"
    },
    {
      "name": "Spec Strip",
      "kind": "custom",
      "refersTo": "spec-cell",
      "description": "Five fixed tiles: number over label. Never collapses or reorders; an unstated spec keeps its slot as an em dash.",
      "html": "<dl class=\"ds-spec-strip\"><div class=\"ds-spec-cell\"><dd class=\"ds-spec-value\">13.0m</dd><dt class=\"ds-spec-label\">height</dt></div><div class=\"ds-spec-cell\"><dd class=\"ds-spec-value\">10T</dd><dt class=\"ds-spec-label\">crane</dt></div><div class=\"ds-spec-cell\"><dd class=\"ds-spec-value\">100HP</dd><dt class=\"ds-spec-label\">power</dt></div><div class=\"ds-spec-cell\"><dd class=\"ds-spec-value\">4</dd><dt class=\"ds-spec-label\">docks</dt></div><div class=\"ds-spec-cell\"><dd class=\"ds-spec-value ds-unknown\" title=\"Not stated in the listing\">—</dd><dt class=\"ds-spec-label\">floor</dt></div></dl>",
      "css": ".ds-spec-strip{display:grid;grid-template-columns:repeat(5,1fr);gap:2px;margin:0;font-family:'Google Sans',system-ui,sans-serif}.ds-spec-cell{min-width:0;padding:6px 6px 5px;border-radius:8px;background:rgba(16,24,40,.035)}.ds-spec-value{font-size:15px;font-weight:600;letter-spacing:-.01em;font-variant-numeric:tabular-nums;line-height:1.2;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:0;color:#101828}.ds-unknown{color:#98a2b3}.ds-spec-label{font-size:11px;font-weight:500;letter-spacing:.01em;color:#667085;line-height:1.25;margin-top:2px}"
    },
    {
      "name": "Zone Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Legend and cluster filter in one control. The dot is the cluster hue; active fills with it.",
      "html": "<div class=\"ds-chiprow\"><button class=\"ds-chip\" style=\"--zone:#e07b39\" aria-pressed=\"true\"><span class=\"ds-dot\"></span>Chakan</button><button class=\"ds-chip\" style=\"--zone:#2e7fd4\" aria-pressed=\"false\"><span class=\"ds-dot\"></span>Bhosari</button></div>",
      "css": ".ds-chiprow{display:flex;gap:6px;font-family:'Google Sans',system-ui,sans-serif}.ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:5px 12px;border:1px solid rgba(16,24,40,.16);border-radius:999px;background:#fff;color:#101828;font-size:13px;font-weight:500;cursor:pointer;transition:border-color 120ms ease,background 120ms ease}.ds-chip:hover{border-color:#101828}.ds-chip[aria-pressed=\"true\"]{background:var(--zone);border-color:var(--zone);color:#fff}.ds-dot{width:9px;height:9px;border-radius:999px;background:var(--zone);flex:none}.ds-chip[aria-pressed=\"true\"] .ds-dot{background:#fff}.ds-chip:focus-visible{outline:2px solid #1862dc;outline-offset:2px}"
    },
    {
      "name": "Listing Card",
      "kind": "card",
      "refersTo": "card",
      "description": "White, plainly rounded, no coloured side border. The zone reaches it through the dot beside the locality.",
      "html": "<article class=\"ds-card\" style=\"--zone:#e07b39\"><div class=\"ds-card-top\"><span class=\"ds-card-loc\"><span class=\"ds-dot\"></span>Chakan MIDC Phase II</span><span class=\"ds-status\">Ready</span></div><h3 class=\"ds-card-title\">45,000 sq ft shed</h3></article>",
      "css": ".ds-card{background:#fff;border:1px solid rgba(16,24,40,.08);border-radius:14px;padding:12px;font-family:'Google Sans',system-ui,sans-serif;transition:box-shadow 140ms ease}.ds-card:hover{box-shadow:0 8px 28px rgba(16,24,40,.12),0 1px 3px rgba(16,24,40,.08)}.ds-card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.ds-card-loc{display:flex;align-items:center;gap:6px;font-size:11px;font-weight:500;color:#667085}.ds-dot{width:9px;height:9px;border-radius:999px;background:var(--zone);flex:none}.ds-status{font-size:11px;font-weight:500;border-radius:999px;padding:2px 8px;background:#101828;color:#fff}.ds-card-title{font-size:18px;font-weight:700;line-height:1.15;letter-spacing:-.018em;margin:4px 0 0;color:#101828}"
    },
    {
      "name": "Action Button",
      "kind": "button",
      "refersTo": "btn-action",
      "description": "The one blue. Marks what the user can do, never what a thing is.",
      "html": "<button class=\"ds-btn\"><span>+</span> Add space for free</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:7px 14px;border:1px solid transparent;border-radius:999px;background:#1862dc;color:#fff;font-family:'Google Sans',system-ui,sans-serif;font-size:13px;font-weight:600;cursor:pointer;box-shadow:0 2px 8px rgba(16,24,40,.1);transition:filter 120ms ease}.ds-btn:hover{filter:brightness(1.08)}.ds-btn:focus-visible{outline:2px solid #1862dc;outline-offset:2px}"
    },
