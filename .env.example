# Server-side read-only access to Supabase. When unset, the app reads data/seed.csv.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Basemap vector tiles (PMTiles archive URL). Defaults to the Protomaps demo bucket,
# which is rate-limited and NOT for production - self-host a Pune-region .pmtiles extract.
NEXT_PUBLIC_PMTILES_URL=
