# The site's own address, used for canonical and og:url. Leave unset on Vercel:
# it falls back to the project's production domain, which becomes your custom
# domain by itself once you attach one. Set it only to pin a domain before it is
# attached, and never in Preview - previews name themselves so they cannot
# compete with production for the same pages.
NEXT_PUBLIC_SITE_URL=

# The site the Plausible account is registered against, e.g. example.in. The
# tag renders only when this is set and only on the production deployment, so
# previews never reach the stats. Leave unset until the account exists.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Server-side read-only access to Supabase. When unset, the app reads data/seed.csv.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Basemap vector tiles (PMTiles archive URL). Defaults to the Protomaps demo bucket,
# which is rate-limited and NOT for production - self-host a Pune-region .pmtiles extract.
NEXT_PUBLIC_PMTILES_URL=

# Basemap. Default is OpenFreeMap Positron (keyless). Set a CARTO key to use
# CARTO's basemaps unwatermarked; NEXT_PUBLIC_CARTO_STYLE picks light_all or voyager.
NEXT_PUBLIC_CARTO_API_KEY=
NEXT_PUBLIC_CARTO_STYLE=
